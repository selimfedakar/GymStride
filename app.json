{
  "expo": {
    "name": "GymStride",
    "slug": "gymstride",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "gymstride",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "bundleIdentifier": "com.selimfedakar.gymstride",
      "buildNumber": "1",
      "supportsTablet": false,
      "requireFullScreen": true,
      "appleTeamId": "PAST7W47P5",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.selimfedakar.gymstride",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#FF6B35",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GymStride uses your location to show nearby workout partners."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GymStride needs access to your photos to set your profile picture.",
          "cameraPermission": "GymStride needs your camera to take a profile picture."
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "20585861-3e16-464b-a95b-ce7d8a84039e"
      },
      "router": {}
    },
    "owner": "selimfedakar",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/20585861-3e16-464b-a95b-ce7d8a84039e"
    }
  }
}
